{
  "name": "license-plate-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node ../../directory/scripts/ng-build-gate.mjs build && node ../../directory/scripts/stamp-dist-git-source.mjs --dist=dist/license-plate-app/browser --repo=..",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "npm run deploy:dryl",
    "deploy:dryl": "node ..\\..\\directory\\scripts\\run-full-deploy.mjs plates",
    "deploy:staging": "node ..\\..\\directory\\scripts\\run-full-deploy-staging.mjs plates",
    "verify:staging": "node ..\\..\\directory\\scripts\\verify-staging.mjs plates",
    "verify:dist": "npm run build && node ..\\..\\directory\\scripts\\verify-dist-git-sha.mjs --dist=dist/license-plate-app/browser --repo=.. --site-id=plates",
    "verify:console": "node ..\\..\\directory\\scripts\\smoke-spa-console.mjs plates",
    "sync:errors": "node ..\\..\\directory\\scripts\\sync-error-reporter.mjs --only kennzeichen",
    "sync:favicons": "node ..\\..\\directory\\scripts\\sync-favicons.mjs kennzeichen",
    "prebuild": "npm run sync:favicons && npm run sync:errors",
    "verify:dist:local": "npm run build && node ..\\..\\directory\\scripts\\verify-dist-git-sha.mjs --dist=dist/license-plate-app/browser --repo=.. --site-id=plates && node ..\\..\\directory\\scripts\\smoke-spa-console.mjs plates --local",
    "verify:visual": "node ..\\..\\directory\\scripts\\assert-deploy-screenshots.mjs plates"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@dryl/app-data": "file:../../dryl/app-data",
    "@dryl/auth-client": "file:../../dryl/auth-client",
    "@dryl/storage": "file:../../dryl/storage",
    "@types/leaflet": "^1.9.20",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.2",
    "@angular/cli": "^20.3.2",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  },
  "dryl": {
    "packages": {
      "@dryl/auth-client": "0.2.0",
      "@dryl/app-data": "0.3.1",
      "@dryl/storage": "0.3.0"
    }
  }
}
